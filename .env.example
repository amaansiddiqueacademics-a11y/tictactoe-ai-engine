# Copy to .env. Every variable is optional for local development.

# Signs guest tokens. Required (and must not be the default) when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret

# Omit both to run with in-memory rooms and no match history (zero setup).
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://game:change-me@localhost:5432/tictactoe

# Extra allowed browser origins, comma separated. Not needed when the client is served
# from the same origin (Vite proxy in dev, nginx in Docker, or `npm start` after a build).
# CLIENT_ORIGIN=https://your-frontend.example.com

PORT=3001

# Docker Compose only
POSTGRES_DB=tictactoe
POSTGRES_USER=game
POSTGRES_PASSWORD=change-me

# Guest tokens per IP per minute (default 60 in production, unlimited otherwise; 0 = unlimited).
# GUEST_RATE_LIMIT=60
